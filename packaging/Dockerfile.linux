# Build on glibc 2.35 for Ubuntu 22.04+ and Debian 12+ (amd64).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip binutils libgl1 libegl1 libx11-6 libxext6 \
    libxrender1 libxi6 libxkbcommon-x11-0 libxcb-xinerama0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-render-util0 libfontconfig1 \
    libdbus-1-3 xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-build.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-build.txt
COPY mascote.py LICENSE README.md ./
COPY assets/ assets/
COPY scripts/ scripts/
RUN xvfb-run -a python3 scripts/smoke_test.py \
    && python3 -m PyInstaller --clean --noconfirm --onefile \
       --name clips-1.0-linux-x86_64 --add-data assets:assets \
       --add-data LICENSE:. mascote.py \
    && xvfb-run -a python3 scripts/smoke_test.py /app/dist/clips-1.0-linux-x86_64
